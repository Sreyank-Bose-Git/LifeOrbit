rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if accessing own user record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User cloud workspaces / state
    match /user_workspaces/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Endeavors collection per user
    match /users/{userId}/endeavors/{endeavorId} {
      allow read, write: if isOwner(userId);
    }

    // Progress logs per user
    match /users/{userId}/logs/{logId} {
      allow read, write: if isOwner(userId);
    }

    // Timeblocks per user
    match /users/{userId}/timeblocks/{blockId} {
      allow read, write: if isOwner(userId);
    }

    // Stats per user
    match /users/{userId}/stats/{statsId} {
      allow read, write: if isOwner(userId);
    }
  }
}
